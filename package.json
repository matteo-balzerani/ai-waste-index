{
  "name": "ai-waste-index",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:worker": "esbuild src/server/extraction/parser-worker.ts --bundle --platform=node --target=node22 --outfile=.generated/extraction-parser.cjs",
    "predev": "npm run build:worker && npm run build:ocr",
    "prebuild": "npm run build:worker && npm run build:ocr",
    "pretest": "npm run build:worker && npm run build:ocr",
    "build:ocr": "node scripts/build-ocr.mjs"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@mozilla/readability": "^0.6.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ita": "1.0.0",
    "buffer": "6.0.3",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.13",
    "negotiator": "^1.1.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
