# Server-only estimator settings. Replace the placeholder key locally.
# Never rename these with a NEXT_PUBLIC_ prefix.
ESTIMATOR_BASE_URL=http://127.0.0.1:8787
ESTIMATOR_API_KEY=replace-me
ESTIMATOR_TIMEOUT_MS=5000
MAX_ESTIMATOR_RESPONSE_BYTES=65536
MAX_ANALYSIS_TEXT_CHARS=50000

# Explicit local demo; run npm run dev on loopback. Production remains blocked.
APP_ENV=local-demo
MAX_REQUEST_BODY_BYTES=1000000
REQUEST_BODY_TIMEOUT_MS=5000

# URL extraction resource limits; no production quota admission yet.
MAX_URL_CHARS=8192
MAX_URL_RESPONSE_BYTES=2000000
MAX_URL_DECODED_BYTES=2000000
MAX_URL_RESPONSE_HEADER_BYTES=16384
URL_CONNECT_TIMEOUT_MS=2000
URL_FETCH_TIMEOUT_MS=5000
URL_MAX_REDIRECTS=3

# Browser-only screenshot/OCR limits.
MAX_SCREENSHOT_BYTES=10000000
MAX_SCREENSHOT_PIXELS=16000000
MAX_SCREENSHOT_WIDTH=16000
MAX_SCREENSHOT_HEIGHT=16000
OCR_TIMEOUT_MS=30000
