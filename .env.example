# Server-only estimator settings. Replace the placeholder key locally.
# Never rename these with a NEXT_PUBLIC_ prefix.
ESTIMATOR_BASE_URL=http://127.0.0.1:8787
ESTIMATOR_API_KEY=replace-me
ESTIMATOR_TIMEOUT_MS=5000
MAX_ESTIMATOR_RESPONSE_BYTES=65536
MAX_ANALYSIS_TEXT_CHARS=50000

# Explicit local demo; run npm run dev on loopback. Production remains blocked.
APP_ENV=local-demo
MAX_REQUEST_BODY_BYTES=1000000
REQUEST_BODY_TIMEOUT_MS=5000
